name: Etiquetar validación

# Cuando entra en main un fichero de congelación del conjunto de validación (historia #54),
# crea la etiqueta anotada validacion-vN sobre ese commit si no existe.

on:
  push:
    branches: [main]
    paths:
      - "docs/validacion/CONGELADO*.md"

permissions:
  contents: write

jobs:
  etiquetar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Crear las etiquetas validacion-vN que falten
        env:
          ANTES: ${{ github.event.before }}
          DESPUES: ${{ github.sha }}
        run: |
          set -euo pipefail
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          if [ "$ANTES" = "0000000000000000000000000000000000000000" ]; then
            ficheros=$(git ls-files 'docs/validacion/CONGELADO*.md')
          else
            ficheros=$(git diff --name-only --diff-filter=AM "$ANTES" "$DESPUES" -- 'docs/validacion/CONGELADO*.md')
          fi
          for fichero in $ficheros; do
            version=$(sed -n 's/^version: *\([0-9][0-9]*\) *$/\1/p' "$fichero" | head -n 1)
            if [ -z "$version" ]; then
              echo "::error file=$fichero::no declara 'version: N'"
              exit 1
            fi
            etiqueta="validacion-v$version"
            if git rev-parse -q --verify "refs/tags/$etiqueta" > /dev/null; then
              echo "$etiqueta ya existe: no se hace nada"
              continue
            fi
            git tag -a "$etiqueta" "$DESPUES" -m "Conjunto de validación congelado, versión $version"
            git push origin "refs/tags/$etiqueta"
          done
